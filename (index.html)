<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XSOSA LOGS AND MORE - SMM & Digital Marketplace</title>
    <style>
        :root {
            --bg-dark: #0a0d14;
            --sidebar-bg: #111625;
            --card-bg: #161c2e;
            --accent-purple: #7c3aed;
            --accent-blue: #2563eb;
            --accent-glow: rgba(124, 58, 237, 0.4);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --border-color: #1e293b;
            --success: #10b981;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-primary);
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar Navigation */
        aside {
            width: 260px;
            background-color: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand {
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: var(--text-primary);
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .brand span {
            color: var(--accent-purple);
        }

        .nav-menu {
            list-style: none;
        }

        .nav-item {
            margin-bottom: 8px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.2s;
        }

        .nav-link.active, .nav-link:hover {
            background-color: var(--accent-purple);
            color: #fff;
            box-shadow: 0 0 15px var(--accent-glow);
        }

        /* Main Content Dashboard */
        main {
            flex: 1;
            padding: 30px 40px;
            overflow-y: auto;
        }

        /* Top Header Bar */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
        }

        .search-box {
            position: relative;
            width: 320px;
        }

        .search-box input {
            width: 100%;
            padding: 12px 16px;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: #fff;
            outline: none;
        }

        .user-balance-card {
            background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue));
            padding: 10px 20px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 600;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .user-balance-card button {
            background-color: #fff;
            color: #000;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            font-size: 0.85rem;
        }

        /* Filter Tabs */
        .category-tabs {
            display: flex;
            gap: 12px;
            margin-bottom: 25px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .tab-btn {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 10px 18px;
            border-radius: 20px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .tab-btn.active, .tab-btn:hover {
            border-color: var(--accent-purple);
            color: var(--text-primary);
            background-color: rgba(124, 58, 237, 0.15);
        }

        /* Marketplace Product Table / Grid */
        .catalog-section {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
        }

        .service-row {
            display: grid;
            grid-template-columns: 2fr 1.5fr 1fr 120px;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid var(--border-color);
            gap: 15px;
        }

        .service-row:last-child {
            border-bottom: none;
        }

        .service-info h4 {
            font-size: 1rem;
            margin-bottom: 4px;
        }

        .service-info p {
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .badge-stock {
            color: var(--success);
            background: rgba(16, 185, 129, 0.1);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.82rem;
            font-weight: 600;
            width: fit-content;
        }

        .price-tag {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .btn-order {
            background-color: var(--accent-purple);
            color: #fff;
            border: none;
            padding: 10px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            width: 100%;
        }

        .btn-order:hover {
            background-color: #6d28d9;
        }

        /* Order Modal Panel */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 100;
        }

        .modal {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            width: 90%;
            max-width: 450px;
            padding: 28px;
        }

        .modal h3 {
            margin-bottom: 15px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 12px;
            background-color: var(--bg-dark);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: #fff;
            outline: none;
        }

        .modal-buttons {
            display: flex;
            gap: 10px;
            margin-top: 25px;
        }

        .btn-close {
            background-color: #334155;
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 6px;
            cursor: pointer;
            width: 50%;
            font-weight: 600;
        }

        .btn-confirm {
            background-color: var(--accent-purple);
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 6px;
            cursor: pointer;
            width: 50%;
            font-weight: 600;
        }

        @media (max-width: 768px) {
            body { flex-direction: column; }
            aside { width: 100%; border-right: none; border-bottom: 1px solid var(--border-color); }
            main { padding: 20px; }
            .top-bar { flex-direction: column; gap: 15px; align-items: stretch; }
            .search-box { width: 100%; }
            .service-row { grid-template-columns: 1fr; gap: 10px; }
        }
    </style>
</head>
<body>

    <!-- Sidebar Navigation -->
    <aside>
        <div>
            <div class="brand">XSOSA LOGS <span>AND MORE</span></div>
            <ul class="nav-menu">
                <li class="nav-item"><a href="#" class="nav-link active">🛒 Store Catalog</a></li>
                <li class="nav-item"><a href="#" class="nav-link">💳 Add Funds</a></li>
                <li class="nav-item"><a href="#" class="nav-link">📦 Order History</a></li>
                <li class="nav-item"><a href="#" class="nav-link">⚡ API Access</a></li>
                <li class="nav-item"><a href="#" class="nav-link">💬 Support Tickets</a></li>
            </ul>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main>
        <div class="top-bar">
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="Search services or account logs..." onkeyup="filterCatalog()">
            </div>
            <div class="user-balance-card">
                <span>Balance: $0.00</span>
                <button onclick="alert('Redirecting to Deposit Gateway...')">Deposit</button>
            </div>
        </div>

        <!-- Filter Pills -->
        <div class="category-tabs">
            <button class="tab-btn active" onclick="filterCategory('all', event)">All Services</button>
            <button class="tab-btn" onclick="filterCategory('social', event)">Social Media Logs</button>
            <button class="tab-btn" onclick="filterCategory('esim', event)">eSIM Vouchers</button>
            <button class="tab-btn" onclick="filterCategory('boosting', event)">Follower Boosting</button>
        </div>

        <!-- Catalog List -->
        <div class="catalog-section" id="serviceCatalog">
            <!-- Rows dynamically populating via JS -->
        </div>
    </main>

    <!-- Purchase Modal -->
    <div class="modal-overlay" id="orderModal">
        <div class="modal">
            <h3 id="modalServiceTitle">Order Service</h3>
            <p id="modalServiceDesc" style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 20px;"></p>
            
            <div class="form-group">
                <label for="deliveryInput">Delivery Email / Telegram Username / Phone</label>
                <input type="text" id="deliveryInput" placeholder="Enter contact info...">
            </div>

            <div class="form-group">
                <label for="quantityInput">Quantity</label>
                <input type="number" id="quantityInput" value="1" min="1" oninput="updateTotalPrice()">
            </div>

            <div style="margin-top: 15px; font-weight: 700; font-size: 1.1rem;" id="totalPriceDisplay">
                Total: $0.00
            </div>

            <div class="modal-buttons">
                <button class="btn-close" onclick="closeModal()">Cancel</button>
                <button class="btn-confirm" onclick="processOrder()">Submit Order</button>
            </div>
        </div>
    </div>

    <script>
        const catalogData = [
            { id: "S101", category: "social", name: "Aged Social Media Account (2021)", desc: "High-trust active profile with original email attached.", price: 15.00, stock: 12 },
            { id: "S102", category: "social", name: "Verified Premium Profile", desc: "Includes backup security codes and recovery data.", price: 35.00, stock: 5 },
            { id: "S103", category: "esim", name: "Global Roaming eSIM Profile Key", desc: "Instant digital activation voucher.", price: 25.00, stock: 20 },
            { id: "S104", category: "boosting", name: "Instagram Real Followers (1,000 Pack)", desc: "High-retention non-drop follower package.", price: 8.50, stock: 999 },
            { id: "S105", category: "boosting", name: "TikTok Channel Views (10,000 Pack)", desc: "Instant high-speed delivery boost.", price: 5.00, stock: 999 }
        ];

        let selectedItem = null;

        function renderCatalog(items) {
            const container = document.getElementById('serviceCatalog');
            container.innerHTML = '';

            items.forEach(item => {
                container.innerHTML += `
                    <div class="service-row">
                        <div class="service-info">
                            <h4>${item.name}</h4>
                            <p>${item.desc}</p>
                        </div>
                        <div><span class="badge-stock">${item.stock} in stock</span></div>
                        <div class="price-tag">$${item.price.toFixed(2)}</div>
                        <div><button class="btn-order" onclick="openOrderModal('${item.id}')">Order</button></div>
                    </div>
                `;
            });
        }

        function filterCategory(cat, e) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            if(e && e.target) e.target.classList.add('active');

            if (cat === 'all') {
                renderCatalog(catalogData);
            } else {
                renderCatalog(catalogData.filter(i => i.category === cat));
            }
        }

        function filterCatalog() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            renderCatalog(catalogData.filter(i => i.name.toLowerCase().includes(q) || i.desc.toLowerCase().includes(q)));
        }

        function openOrderModal(id) {
            selectedItem = catalogData.find(i => i.id === id);
            document.getElementById('modalServiceTitle').innerText = selectedItem.name;
            document.getElementById('modalServiceDesc').innerText = selectedItem.desc;
            document.getElementById('quantityInput').value = 1;
            updateTotalPrice();
            document.getElementById('orderModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('orderModal').style.display = 'none';
        }

        function updateTotalPrice() {
            const qty = parseInt(document.getElementById('quantityInput').value) || 1;
            const total = selectedItem ? selectedItem.price * qty : 0;
            document.getElementById('totalPriceDisplay').innerText = `Total: $${total.toFixed(2)}`;
        }

        function processOrder() {
            const contact = document.getElementById('deliveryInput').value;
            if(!contact) {
                alert('Please enter your delivery contact details.');
                return;
            }
            const qty = parseInt(document.getElementById('quantityInput').value) || 1;
            const total = (selectedItem.price * qty).toFixed(2);
            
            const textMsg = `Hello XSOSA LOGS AND MORE,\nI want to order:\n- Item: ${selectedItem.name}\n- Qty: ${qty}\n- Total: $${total}\n- Delivery Contact: ${contact}`;
            
            // Redirect directly to WhatsApp checkout
            const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(textMsg)}`;
            window.open(whatsappUrl, '_blank');
            closeModal();
        }

        // Initial Load
        renderCatalog(catalogData);
    </script>
</body>
</html>
